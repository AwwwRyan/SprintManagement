# ---- Firebase web app config (Firebase console > Project settings > Your apps > Web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Not used (free Spark plan, no Cloud Storage; attachments live in Firestore). Fill in from the config anyway.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only, NEVER prefix with NEXT_PUBLIC_) ----
# Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value on one line, keeping the \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# true = use the local Firebase Emulator Suite (npm run emulators). Use false (or remove) in production.
NEXT_PUBLIC_USE_EMULATORS=false
