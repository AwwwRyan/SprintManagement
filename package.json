{
  "name": "sprint-task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sprint-manager \"vitest run tests/rules\"",
    "test:all": "npm run test && npm run test:rules",
    "emulators": "firebase emulators:start --project demo-sprint-manager",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "emulators:persist": "firebase emulators:start --project demo-sprint-manager --import=./emulator-data --export-on-exit=./emulator-data",
    "test:e2e": "playwright test",
    "check-env": "tsx scripts/check-env.ts",
    "deploy:firestore": "tsx scripts/deploy-firestore.ts",
    "verify-setup": "tsx scripts/verify-setup.ts",
    "test:smoke": "tsx scripts/smoke.ts run",
    "dev:emulator": "tsx scripts/dev-emulator.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
