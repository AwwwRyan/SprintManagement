# Settings for local development against the Firebase Emulator Suite.
# Copy to .env.local (cp .env.emulator .env.local) to run the app without a real Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sprint-manager.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sprint-manager
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sprint-manager.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
FIREBASE_ADMIN_PROJECT_ID=demo-sprint-manager
NEXT_PUBLIC_USE_EMULATORS=true
