rules_version = '2';

// Sprint Task Manager: Firestore security rules.
// Mirrors lib/permissions.ts (UI) and the permission table in the spec (§3).
// Tested by tests/rules/firestore.rules.test.ts (run: npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Every read/write requires an active user profile.
    function isActive() {
      return signedIn() && get(/databases/$(database)/documents/users/$(uid())).data.active == true;
    }
    // Role comes from the custom claim; the Firestore doc mirrors it for the UI.
    function role() { return request.auth.token.role; }
    function isAdmin() { return isActive() && role() == 'admin'; }
    function isStaff() { return isActive() && role() in ['admin', 'qa']; }

    function sprintData(sprintId) { return get(/databases/$(database)/documents/sprints/$(sprintId)).data; }
    // Errors (e.g. missing sprint) evaluate to deny.
    function sprintOpen(sprintId) { return sprintData(sprintId).status != 'closed'; }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function unchanged(keys) { return !changed().hasAny(keys); }

    function isDateString(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optString(v) { return v == null || v is string; }
    function optHours(v) { return v == null || (v is number && v >= 0 && v <= 1000); }

    // ---------------------------------------------------------------- users

    match /users/{userId} {
      // Users may always read their own doc (so a deactivated session can see it was deactivated).
      allow read: if isActive() || (signedIn() && uid() == userId);
      // Everything else is Admin SDK only (route handlers / scripts). The one exception is the
      // avatar colour: your own, or anyone's for admins.
      allow create, delete: if false;
      allow update: if isActive() && (uid() == userId || isAdmin())
        && changed().hasOnly(['avatarColor'])
        && (request.resource.data.avatarColor == null
            || (request.resource.data.avatarColor is string && request.resource.data.avatarColor.matches('^#[0-9a-fA-F]{6}$')));
    }

    // ---------------------------------------------------------------- master data

    match /appTypes/{appTypeId} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'code', 'color', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.code is string && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 20
        && request.resource.data.code.matches('^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$')
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.active is bool;
      allow delete: if false; // deactivate instead, so historical tasks still render
    }

    match /modules/{moduleId} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'appTypeId', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.appTypeId is string
        && exists(/databases/$(database)/documents/appTypes/$(request.resource.data.appTypeId))
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- sprints

    function validSprint(d) {
      return d.keys().hasOnly(['name', 'goal', 'startDate', 'endDate', 'status', 'createdBy', 'createdAt', 'closedAt', 'closedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.goal is string && d.goal.size() <= 500
        && isDateString(d.startDate) && isDateString(d.endDate) && d.endDate >= d.startDate
        && d.status in ['planned', 'active', 'closed'];
    }

    // meta/activeSprint.sprintId points at the single active sprint (or null).
    function activeMeta() { return get(/databases/$(database)/documents/meta/activeSprint); }
    function noOtherActiveSprint(sprintId) {
      return !exists(/databases/$(database)/documents/meta/activeSprint)
        || activeMeta().data.sprintId == null
        || activeMeta().data.sprintId == sprintId
        // a pointer to a sprint that no longer exists counts as "no active sprint"
        || !exists(/databases/$(database)/documents/sprints/$(activeMeta().data.sprintId))
        || sprintData(activeMeta().data.sprintId).status != 'active';
    }

    match /sprints/{sprintId} {
      allow read: if isActive();

      allow create: if isStaff()
        && sprintId != 'backlog'
        && validSprint(request.resource.data)
        && request.resource.data.status == 'planned'
        && request.resource.data.createdBy == uid()
        && request.resource.data.closedAt == null
        && request.resource.data.closedBy == null;

      // The Backlog: one permanent doc (sprints/backlog, status "backlog"), set up once by an
      // admin and never edited (validSprint rejects its status, so updates are impossible).
      // Tasks live in it like in an open release.
      allow create: if isAdmin()
        && sprintId == 'backlog'
        && request.resource.data.keys().hasOnly(['name', 'goal', 'startDate', 'endDate', 'status', 'createdBy', 'createdAt', 'closedAt', 'closedBy'])
        && request.resource.data.name == 'Backlog'
        && request.resource.data.status == 'backlog'
        && request.resource.data.createdBy == uid()
        && request.resource.data.closedAt == null
        && request.resource.data.closedBy == null;

      allow update: if isStaff()
        && resource.data.status != 'closed'          // closed sprints are read-only
        && validSprint(request.resource.data)
        && unchanged(['createdBy', 'createdAt'])
        && (
          // edit details, status unchanged
          (request.resource.data.status == resource.data.status && unchanged(['closedAt', 'closedBy']))
          // start: planned -> active, only if no other sprint is active
          || (resource.data.status == 'planned' && request.resource.data.status == 'active'
              && unchanged(['closedAt', 'closedBy'])
              && noOtherActiveSprint(sprintId)
              && getAfter(/databases/$(database)/documents/meta/activeSprint).data.sprintId == sprintId)
          // close: active -> closed, report snapshot must exist
          || (resource.data.status == 'active' && request.resource.data.status == 'closed'
              && request.resource.data.closedBy == uid()
              && request.resource.data.closedAt == request.time
              && existsAfter(/databases/$(database)/documents/sprintReports/$(sprintId)))
        );

      allow delete: if false;
    }

    match /meta/activeSprint {
      allow read: if isActive();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['sprintId'])
        && (request.resource.data.sprintId == null
              ? (resource == null || resource.data.sprintId == null
                 || !existsAfter(/databases/$(database)/documents/sprints/$(resource.data.sprintId))
                 || getAfter(/databases/$(database)/documents/sprints/$(resource.data.sprintId)).data.status == 'closed')
              : (request.resource.data.sprintId is string
                 && getAfter(/databases/$(database)/documents/sprints/$(request.resource.data.sprintId)).data.status == 'active'));
    }

    // ---------------------------------------------------------------- reports

    match /sprintReports/{sprintId} {
      allow read: if isActive();
      allow create: if isStaff()
        && request.resource.data.sprintId == sprintId
        && request.resource.data.createdBy == uid()
        && sprintData(sprintId).status == 'active';
      allow update, delete: if false; // immutable snapshot
    }

    // ---------------------------------------------------------------- task key counter

    match /counters/tasks {
      allow read: if isActive();
      // `next` is the number the next task will get; each write may only add 1.
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 2;
      allow update: if isActive()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- suggestions
    // Everyone sees all suggestions and can add their own (with up to 5 screenshots, stored like
    // task attachments). QA/Admin add them to a release or mark them not planned; admins delete.

    function validSuggestion(d) {
      return d.keys().hasOnly(['title', 'details', 'kind', 'status', 'authorId', 'imageCount', 'coverThumb',
                               'declineReason', 'taskId', 'taskKey', 'sprintId', 'sprintName', 'handledBy',
                               'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.details is string && d.details.size() <= 5000
        && d.kind in ['idea', 'problem', 'design', 'other']
        && d.status in ['new', 'added', 'not_planned']
        && d.authorId is string
        && d.imageCount is int && d.imageCount >= 0 && d.imageCount <= 5
        && d.coverThumb is string && d.coverThumb.size() <= 150000
        && d.declineReason is string && d.declineReason.size() <= 500
        && (d.taskId == null || d.taskId is string)
        && (d.taskKey == null || d.taskKey is string)
        && (d.sprintId == null || d.sprintId is string)
        && (d.sprintName == null || d.sprintName is string)
        && (d.handledBy == null || d.handledBy == uid() || d.handledBy == resource.data.handledBy);
    }

    match /suggestions/{suggestionId} {
      allow read: if isActive();
      allow create: if isActive()
        && validSuggestion(request.resource.data)
        && request.resource.data.authorId == uid()
        && request.resource.data.status == 'new'
        && request.resource.data.imageCount == 0 && request.resource.data.coverThumb == ''
        && request.resource.data.taskId == null && request.resource.data.handledBy == null
        && request.resource.data.declineReason == ''
        && request.resource.data.createdAt == request.time;
      allow update: if isActive()
        && validSuggestion(request.resource.data)
        && unchanged(['authorId', 'createdAt', 'title', 'details', 'kind'])
        && (
          // the author adding screenshots while it's new (count goes up with each image batch)
          (resource.data.authorId == uid() && resource.data.status == 'new'
            && changed().hasOnly(['imageCount', 'coverThumb', 'updatedAt'])
            && request.resource.data.imageCount == resource.data.imageCount + 1)
          // QA/Admin: add to a release, mark not planned, or reopen
          || (isStaff() && changed().hasOnly(['status', 'declineReason', 'taskId', 'taskKey', 'sprintId', 'sprintName', 'handledBy', 'updatedAt']))
        );
      allow delete: if isAdmin();

      match /images/{imageId} {
        function parent() { return get(/databases/$(database)/documents/suggestions/$(suggestionId)).data; }
        function imagePath() { return /databases/$(database)/documents/suggestions/$(suggestionId)/images/$(imageId); }

        allow read: if isActive();
        allow create: if isActive()
          && parent().authorId == uid() && parent().status == 'new'
          && request.resource.data.keys().hasOnly(['fileName', 'contentType', 'chunkCount', 'thumbDataUrl', 'sizeBytes', 'width', 'height', 'uploadedBy', 'uploadedAt'])
          && request.resource.data.uploadedBy == uid()
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
          && request.resource.data.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif']
          && request.resource.data.sizeBytes is int && request.resource.data.sizeBytes <= 2621440
          && request.resource.data.width is int && request.resource.data.height is int
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 4
          && request.resource.data.thumbDataUrl is string
          && request.resource.data.thumbDataUrl.size() <= 150000
          && request.resource.data.thumbDataUrl.matches('^data:image/(webp|jpeg);base64,.*')
          && existsAfter(/databases/$(database)/documents/suggestions/$(suggestionId)/images/$(imageId)/chunks/0)
          && existsAfter(/databases/$(database)/documents/suggestions/$(suggestionId)/images/$(imageId)/chunks/$(string(request.resource.data.chunkCount - 1)))
          && getAfter(/databases/$(database)/documents/suggestions/$(suggestionId)).data.imageCount == parent().imageCount + 1;
        allow update: if false;
        allow delete: if isAdmin();

        match /chunks/{chunkId} {
          allow read: if isActive();
          allow create: if isActive()
            && !exists(imagePath())
            && getAfter(imagePath()).data.uploadedBy == uid()
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.index is int
            && request.resource.data.index >= 0
            && request.resource.data.index < getAfter(imagePath()).data.chunkCount
            && chunkId == string(request.resource.data.index)
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 900000;
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // ---------------------------------------------------------------- tasks

    function validTask(d) {
      return d.taskKey is string && d.taskKey.matches('^TSK-[0-9]+$')
        && d.sprintId is string
        && d.order is number
        && d.appTypeId is string && d.appTypeId.size() > 0
        && d.type in ['bug', 'improvement', 'task']
        && optString(d.moduleId)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.description is string && d.description.size() <= 200000
        && d.descriptionText is string
        && d.assigneeIds is list && d.assigneeIds.size() <= 20
        && d.priority in ['critical', 'high', 'medium', 'low']
        && optHours(d.estimatedHours) && optHours(d.actualHours)
        && d.status in ['pending', 'in_progress', 'on_hold', 'dev_done', 'testing', 'done', 'released', 'closed', 'duplicate']
        && d.reporterId is string
        && (d.dueDate == null || isDateString(d.dueDate))
        && (!('releaseDate' in d) || d.releaseDate == null || isDateString(d.releaseDate))
        && d.environment is string && d.environment.size() <= 120
        && (!('remarks' in d) || (d.remarks is string && d.remarks.size() <= 2000))
        && d.stepsToReproduce is string && d.expectedResult is string && d.actualResult is string
        && d.attachmentCount is int && d.attachmentCount >= 0 && d.attachmentCount <= 10
        && d.carryOverCount is int && d.carryOverCount >= 0
        && d.sprintHistory is list
        && (!('suggestionId' in d) || d.suggestionId == null || d.suggestionId is string)
        && d.updatedBy == uid();
    }

    // The key must be the one just reserved from counters/tasks in the same transaction.
    function keyMatchesCounter(d) {
      return getAfter(/databases/$(database)/documents/counters/tasks).data.next
        == int(d.taskKey.split('-')[1]) + 1;
    }

    // Every active user may edit any task in an open sprint (team decision, see DECISIONS.md).
    // Field-level limits for developers are applied in the task update rule below.
    function canEditTaskData(t) { return isActive() && sprintOpen(t.sprintId); }

    match /tasks/{taskId} {
      allow read: if isActive();

      allow create: if isActive()
        && validTask(request.resource.data)
        && request.resource.data.reporterId == uid()
        && sprintOpen(request.resource.data.sprintId)
        && request.resource.data.attachmentCount == 0
        && request.resource.data.carryOverCount == 0
        && request.resource.data.sprintHistory.size() == 0
        // new bugs must say where they were found (owner's rule, 2026-10-27)
        && !(request.resource.data.type == 'bug' && request.resource.data.environment == '')
        && keyMatchesCounter(request.resource.data);

      allow update: if isActive()
        && validTask(request.resource.data)
        && unchanged(['taskKey', 'reporterId', 'createdAt'])
        // Ready to Release / Released tasks never go to the Backlog (owner's rule)
        && !(request.resource.data.sprintId == 'backlog' && resource.data.sprintId != 'backlog'
             && request.resource.data.status in ['done', 'released'])
        && (
          // Normal edit inside an open sprint (moving to another open sprint is staff-only below).
          (sprintOpen(resource.data.sprintId) && sprintOpen(request.resource.data.sprintId)
            && (isStaff()
                || unchanged(['sprintId', 'carryOverCount', 'sprintHistory'])))
          // Carry-forward out of a closed sprint: QA/Admin, only the carry fields.
          || (isStaff()
              && !sprintOpen(resource.data.sprintId)
              && sprintOpen(request.resource.data.sprintId)
              && changed().hasOnly(['sprintId', 'order', 'carryOverCount', 'sprintHistory', 'updatedAt', 'updatedBy']))
        );

      allow delete: if isStaff() && sprintOpen(resource.data.sprintId);

      // ------------------------------------------------ comments
      match /comments/{commentId} {
        function taskOpen() { return sprintOpen(get(/databases/$(database)/documents/tasks/$(taskId)).data.sprintId); }
        function validBody(b) { return b is string && b.size() > 0 && b.size() <= 5000; }

        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.keys().hasOnly(['authorId', 'body', 'createdAt', 'editedAt'])
          && request.resource.data.authorId == uid()
          && validBody(request.resource.data.body)
          && request.resource.data.editedAt == null
          && taskOpen();
        allow update: if isActive()
          && resource.data.authorId == uid()
          && changed().hasOnly(['body', 'editedAt'])
          && validBody(request.resource.data.body)
          && taskOpen();
        allow delete: if isActive()
          && (resource.data.authorId == uid() || isStaff())
          && taskOpen();
      }

      // ------------------------------------------------ attachments
      // Stored in Firestore (Spark plan has no Cloud Storage): metadata + thumbnail here,
      // the base64 image in ./chunks/{index}. Written/deleted in one batch by lib/services/attachments.ts.
      match /attachments/{attachmentId} {
        function parentTask() { return get(/databases/$(database)/documents/tasks/$(taskId)).data; }
        function metaPath() { return /databases/$(database)/documents/tasks/$(taskId)/attachments/$(attachmentId); }

        allow read: if isActive();
        allow create: if canEditTaskData(parentTask())
          && request.resource.data.keys().hasOnly(['fileName', 'contentType', 'chunkCount', 'thumbDataUrl', 'sizeBytes', 'width', 'height', 'uploadedBy', 'uploadedAt'])
          && request.resource.data.uploadedBy == uid()
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
          && request.resource.data.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif']
          && request.resource.data.sizeBytes is int && request.resource.data.sizeBytes <= 2621440
          && request.resource.data.width is int && request.resource.data.height is int
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 4
          && request.resource.data.thumbDataUrl is string
          && request.resource.data.thumbDataUrl.size() <= 150000
          && request.resource.data.thumbDataUrl.matches('^data:image/(webp|jpeg);base64,.*')
          // first and last chunk are written in the same batch
          && existsAfter(/databases/$(database)/documents/tasks/$(taskId)/attachments/$(attachmentId)/chunks/0)
          && existsAfter(/databases/$(database)/documents/tasks/$(taskId)/attachments/$(attachmentId)/chunks/$(string(request.resource.data.chunkCount - 1)))
          // attachmentCount goes up by exactly one in the same batch, and stays <= 10
          && getAfter(/databases/$(database)/documents/tasks/$(taskId)).data.attachmentCount == parentTask().attachmentCount + 1;
        allow update: if false;
        allow delete: if canEditTaskData(parentTask())
          && (isStaff() || resource.data.uploadedBy == uid());

        match /chunks/{chunkId} {
          allow read: if isActive();
          // Only together with brand-new metadata (no adding/replacing chunks later).
          allow create: if canEditTaskData(parentTask())
            && !exists(metaPath())
            && getAfter(metaPath()).data.uploadedBy == uid()
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.index is int
            && request.resource.data.index >= 0
            && request.resource.data.index < getAfter(metaPath()).data.chunkCount
            && chunkId == string(request.resource.data.index)
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 900000;
          allow update: if false;
          allow delete: if canEditTaskData(parentTask())
            && (isStaff() || get(metaPath()).data.uploadedBy == uid());
        }
      }

      // ------------------------------------------------ activity log (append-only)
      // Not gated on sprint state: entries are always written in the same batch as a change
      // that is itself gated, and per-entry task lookups would exceed the rules get() limit for
      // large carry-forward batches. See DECISIONS.md.
      match /activity/{activityId} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.keys().hasOnly(['actorId', 'action', 'field', 'oldValue', 'newValue', 'createdAt'])
          && request.resource.data.actorId == uid()
          && request.resource.data.action in ['created', 'updated', 'carried_over', 'moved', 'attachment_added', 'attachment_removed', 'comment_added']
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- activity across tasks
    // Read-only collection-group access for the date-range report export (lib/services/reports.ts).
    // Writes stay governed by the per-task rule above.
    match /{path=**}/activity/{activityId} {
      allow read: if isActive();
    }

    // ---------------------------------------------------------------- presence

    match /presence/{sprintId}/viewers/{viewerId} {
      allow read: if isActive();
      allow create, update: if isActive()
        && viewerId == uid()
        && request.resource.data.keys().hasOnly(['name', 'initials', 'viewingTaskId', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.initials is string
        && optString(request.resource.data.viewingTaskId)
        && request.resource.data.lastSeen == request.time;
      // allowed even after deactivation, so the user's own cleanup still succeeds
      allow delete: if signedIn() && viewerId == uid();
    }
  }
}
